# Copiar a .env. Nest y prisma7.config.ts cargan este archivo.
PORT=3000
# Ejemplo local para docker-compose.yml; usar credenciales propias al desplegar.
DATABASE_URL="postgresql://kamadeva_user:kamadeva_password@localhost:5432/kamadeva_db"
# Generar dos secretos diferentes: openssl rand -hex 32 (una vez para cada uno).
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Enteros en segundos o sufijos s/m/h/d; ejemplo: 900 = 15m.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Costo bcrypt para contraseñas: entero entre 4 y 31; predeterminado 12.
BCRYPT_ROUNDS=12
# Credenciales del entorno de productos Cloudinary (obligatorias al arrancar).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
