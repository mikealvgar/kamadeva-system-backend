generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum CashAdjustmentType {
  INCOME
  WITHDRAWAL
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  email        String   @unique
  passwordHash String
  telefono     String?
  activo       Boolean  @default(true)

  rolId String? @db.Uuid
  rol   Role?   @relation(fields: [rolId], references: [id])

  refreshTokens      RefreshToken[]
  quotes             Quote[]             @relation("QuoteCreatedBy")
  sales              Sale[]              @relation("SaleCreatedBy")
  cancelledSales     Sale[]              @relation("SaleCancelledBy")
  expenses           Expense[]
  purchases          Purchase[]          @relation("PurchaseCreatedBy")
  cashClosures       CashClosure[]       @relation("CashClosureClosedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")
  idempotencyKeys    IdempotencyKey[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("usuarios")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)

  users User[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("roles")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String
  usuarioId        String    @db.Uuid
  usuario          User      @relation(fields: [usuarioId], references: [id])

  fechaVencimiento DateTime
  fechaRevocacion  DateTime?
  fechaCreacion    DateTime  @default(now())

  @@index([usuarioId])
  @@map("tokens_renovacion")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  descripcion String   @unique
  activo      Boolean  @default(true)

  products Product[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("categorias")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  descripcion String   @unique
  activo      Boolean  @default(true)

  products Product[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("marcas")
}

model Size {
  id     String  @id @default(uuid()) @db.Uuid
  nombre String  @unique
  activo Boolean @default(true)

  quoteItems QuoteItem[]
  saleItems  SaleItem[]

  @@map("tallas")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  codigoBarras     String   @unique
  nombre           String
  descripcion      String?
  imageUrl         String?
  precioVenta      Decimal  @db.Decimal(12, 2)
  precioCompra     Decimal? @db.Decimal(12, 2)
  existenciaMinima Decimal? @db.Decimal(14, 3)
  activo           Boolean  @default(true)

  categoriaId String?   @db.Uuid
  categoria   Category? @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  marcaId String? @db.Uuid
  marca   Brand?  @relation(fields: [marcaId], references: [id], onDelete: Restrict)

  quoteItems         QuoteItem[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([categoriaId])
  @@index([marcaId])
  @@map("productos")
}

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  nombre           String
  telefono         String?
  correo           String?
  activo           Boolean  @default(true)
  esPredeterminado Boolean  @default(false)

  quotes Quote[]
  sales  Sale[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([correo])
  @@map("clientes")
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  productoId        String                @db.Uuid
  producto          Product               @relation(fields: [productoId], references: [id])

  tipo              InventoryMovementType
  cambioExistencias Decimal               @db.Decimal(14, 3)
  costoUnitario     Decimal?              @db.Decimal(12, 2)

  tipoReferencia String?
  referenciaId   String?

  renglonVentaId String?   @db.Uuid
  renglonVenta   SaleItem? @relation(fields: [renglonVentaId], references: [id])

  creadoPorId String? @db.Uuid
  creadoPor   User?   @relation("InventoryMovementCreatedBy", fields: [creadoPorId], references: [id])

  notas         String?
  fechaCreacion DateTime @default(now())

  @@index([productoId])
  @@index([tipo])
  @@index([tipoReferencia, referenciaId])
  @@index([renglonVentaId])
  @@map("movimientos_inventario")
}

model Purchase {
  id             String   @id @default(uuid()) @db.Uuid

  proveedorId    String   @db.Uuid
  proveedor      Provider @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  fechaRecepcion DateTime @default(now())
  folioProveedor String?
  notas          String?
  total          Decimal  @db.Decimal(12, 2)

  creadoPorId String @db.Uuid
  creadoPor   User   @relation("PurchaseCreatedBy", fields: [creadoPorId], references: [id], onDelete: Restrict)

  items         PurchaseItem[]
  fechaCreacion DateTime       @default(now())

  @@index([proveedorId, fechaRecepcion])
  @@index([fechaRecepcion])
  @@map("compras")
}

model PurchaseItem {
  id             String   @id @default(uuid()) @db.Uuid

  compraId       String   @db.Uuid
  compra         Purchase @relation(fields: [compraId], references: [id], onDelete: Restrict)

  productoId     String  @db.Uuid
  producto       Product @relation(fields: [productoId], references: [id], onDelete: Restrict)

  posicion        Int
  nombreProducto  String
  codigoBarras    String
  cantidad        Decimal @db.Decimal(14, 3)
  costoUnitario   Decimal @db.Decimal(12, 2)
  subtotalRenglon Decimal @db.Decimal(12, 2)

  @@unique([compraId, posicion])
  @@index([productoId])
  @@map("renglones_compra")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  folio            Int         @unique @default(autoincrement())
  estado           QuoteStatus @default(DRAFT)

  clienteId        String   @db.Uuid
  cliente          Customer @relation(fields: [clienteId], references: [id])

  items QuoteItem[]

  subtotal  Decimal @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  notas            String?
  fechaVencimiento DateTime?

  creadoPorId String? @db.Uuid
  creadoPor   User?   @relation("QuoteCreatedBy", fields: [creadoPorId], references: [id])

  convertedSale Sale?

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([clienteId])
  @@index([estado])
  @@map("cotizaciones")
}

model QuoteItem {
  id             String  @id @default(uuid()) @db.Uuid

  cotizacionId   String  @db.Uuid
  cotizacion     Quote   @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId     String  @db.Uuid
  producto       Product @relation(fields: [productoId], references: [id])

  tallaId String? @db.Uuid
  talla   Size?   @relation(fields: [tallaId], references: [id], onDelete: Restrict)

  cantidad       Decimal @db.Decimal(14, 3)
  precioUnitario Decimal @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  fechaCreacion DateTime @default(now())

  @@index([tallaId])
  @@index([cotizacionId])
  @@index([productoId])
  @@map("renglones_cotizacion")
}

model Sale {
  id         String        @id @default(uuid()) @db.Uuid
  folio      Int           @unique @default(autoincrement())
  estado     SaleStatus    @default(PENDING)
  metodoPago PaymentMethod @default(CASH)
  fechaPago  DateTime?

  clienteId String?   @db.Uuid
  cliente   Customer? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  cotizacionId String? @unique @db.Uuid
  cotizacion   Quote?  @relation(fields: [cotizacionId], references: [id])

  items SaleItem[]

  subtotal  Decimal @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  creadoPorId String? @db.Uuid
  creadoPor   User?   @relation("SaleCreatedBy", fields: [creadoPorId], references: [id])

  corteCajaId String?      @db.Uuid
  corteCaja   CashClosure? @relation("CashClosureSales", fields: [corteCajaId], references: [id], onDelete: Restrict)

  notas String?

  fechaCancelacion  DateTime?
  canceladoPorId    String?   @db.Uuid
  canceladoPor      User?     @relation("SaleCancelledBy", fields: [canceladoPorId], references: [id])
  motivoCancelacion String?

  idempotencyKeys IdempotencyKey[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([clienteId])
  @@index([estado])
  @@index([corteCajaId])
  @@index([fechaCreacion])
  @@map("ventas")
}

model SaleItem {
  id            String   @id @default(uuid()) @db.Uuid

  ventaId       String   @db.Uuid
  venta         Sale     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId    String   @db.Uuid
  producto      Product  @relation(fields: [productoId], references: [id])

  tallaId String? @db.Uuid
  talla   Size?   @relation(fields: [tallaId], references: [id], onDelete: Restrict)

  cantidad       Decimal  @db.Decimal(14, 3)
  precioUnitario Decimal  @db.Decimal(12, 2)
  descuento      Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  costoUnitario  Decimal? @db.Decimal(12, 2)

  inventoryMovements InventoryMovement[]

  fechaCreacion DateTime @default(now())

  @@index([tallaId])
  @@index([ventaId])
  @@index([productoId])
  @@map("renglones_venta")
}

model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  llave        String
  ambito       String
  hashPeticion String
  estado       IdempotencyStatus @default(PENDING)

  codigoRespuesta Int?
  cuerpoRespuesta Json?
  mensajeError    String?

  usuarioId String? @db.Uuid
  usuario   User?   @relation(fields: [usuarioId], references: [id])

  ventaId String? @db.Uuid
  venta   Sale?   @relation(fields: [ventaId], references: [id])

  fechaVencimiento   DateTime
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@unique([llave, ambito])
  @@index([usuarioId])
  @@index([ventaId])
  @@index([fechaVencimiento])
  @@map("claves_idempotencia")
}

model ExpenseCategory {
  id     String  @id @default(uuid()) @db.Uuid
  nombre String  @unique
  activo Boolean @default(true)

  expenses Expense[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("categorias_gastos")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  concepto        String
  monto           Decimal  @db.Decimal(12, 2)
  descontarDeCaja Boolean  @default(false)
  notas           String?

  fechaGasto DateTime @default(now())

  categoriaId String          @db.Uuid
  categoria   ExpenseCategory @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  creadoPorId String @db.Uuid
  creadoPor   User   @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)

  corteCajaId String?      @db.Uuid
  corteCaja   CashClosure? @relation(fields: [corteCajaId], references: [id], onDelete: Restrict)

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([corteCajaId])
  @@index([fechaGasto])
  @@index([categoriaId])
  @@index([creadoPorId])
  @@map("gastos")
}

model CashClosure {
  id String @id @default(uuid()) @db.Uuid

  corteAnteriorId String?      @unique @db.Uuid
  corteAnterior   CashClosure? @relation("CashClosureChain", fields: [corteAnteriorId], references: [id], onDelete: Restrict)
  siguienteCorte  CashClosure? @relation("CashClosureChain")

  inicioPeriodo DateTime?
  fechaCierre   DateTime  @default(now())

  cerradoPorId String @db.Uuid
  cerradoPor   User   @relation("CashClosureClosedBy", fields: [cerradoPorId], references: [id], onDelete: Restrict)

  fondoInicial        Decimal @db.Decimal(12, 2)
  cantidadVentas      Int
  ventasEfectivo      Decimal @db.Decimal(12, 2)
  ventasTarjeta       Decimal @db.Decimal(12, 2)
  ventasTransferencia Decimal @db.Decimal(12, 2)
  otrasVentas         Decimal @db.Decimal(12, 2)
  reembolsosEfectivo  Decimal @db.Decimal(12, 2)
  reembolsosTotales   Decimal @db.Decimal(12, 2)
  cantidadGastos      Int
  gastosEfectivo      Decimal @db.Decimal(12, 2)
  gastosTotales       Decimal @db.Decimal(12, 2)
  ajustesEntrada      Decimal @db.Decimal(12, 2)
  ajustesSalida       Decimal @db.Decimal(12, 2)
  efectivoEsperado    Decimal @db.Decimal(12, 2)
  efectivoContado     Decimal @db.Decimal(12, 2)
  diferencia          Decimal @db.Decimal(12, 2)
  fondoDejado         Decimal @db.Decimal(12, 2)
  denominaciones      Json
  notas               String?

  adjustments CashClosureAdjustment[]
  sales       Sale[]                  @relation("CashClosureSales")
  expenses    Expense[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@index([fechaCierre])
  @@map("cortes_caja")
}

model CashClosureAdjustment {
  id String @id @default(uuid()) @db.Uuid

  corteCajaId String      @db.Uuid
  corteCaja   CashClosure @relation(fields: [corteCajaId], references: [id], onDelete: Cascade)

  posicion    Int
  tipo        CashAdjustmentType
  monto       Decimal            @db.Decimal(12, 2)
  descripcion String

  fechaCreacion DateTime @default(now())

  @@unique([corteCajaId, posicion])
  @@map("ajustes_corte_caja")
}

model BusinessConfig {
  clave      String @id @default("default")
  nombre     String
  direccion  String
  colonia    String
  municipio  String
  estado     String
  telefono   String
  rfc        String
  mensajePie String

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("configuracion_negocio")
}

model Provider {
  id             String  @id @default(uuid()) @db.Uuid
  nombre         String  @unique
  telefono       String?
  correo         String?
  nombreContacto String?
  direccion      String?
  activo         Boolean @default(true)

  purchases Purchase[]

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  @@map("proveedores")
}
