generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum CashAdjustmentType {
  INCOME
  WITHDRAWAL
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  roles         UserRole[]
  refreshTokens RefreshToken[]

  quotes             Quote[]             @relation("QuoteCreatedBy")
  sales              Sale[]              @relation("SaleCreatedBy")
  cancelledSales     Sale[]              @relation("SaleCancelledBy")
  expenses           Expense[]
  purchases          Purchase[]          @relation("PurchaseCreatedBy")
  cashClosures       CashClosure[]       @relation("CashClosureClosedBy")
  payments           Payment[]           @relation("PaymentCreatedBy")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreatedBy")
  idempotencyKeys    IdempotencyKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  // Product identifier (replaces the former SKU); stored upper-case.
  barcode     String   @unique
  name        String
  description String?
  brand       String?
  imageUrl    String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  // Low-stock threshold for the dashboard; null = not tracked.
  minStock    Decimal? @db.Decimal(14, 3)
  isActive    Boolean  @default(true)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  sizes              ProductSize[]
  quoteItems         QuoteItem[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

model Size {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products   ProductSize[]
  quoteItems QuoteItem[]
  saleItems  SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, name])
  @@map("sizes")
}

model ProductSize {
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeId String @db.Uuid
  size   Size   @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([productId, sizeId])
  @@index([sizeId])
  @@map("product_sizes")
}

model FolioCounter {
  prefix    String @id
  lastValue Int    @default(0)

  updatedAt DateTime @updatedAt

  @@map("folio_counters")
}

model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  quotes Quote[]
  sales  Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("customers")
}

model InventoryMovement {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  type           InventoryMovementType
  quantityChange Decimal               @db.Decimal(14, 3)
  unitCost       Decimal?              @db.Decimal(12, 2)

  referenceType String?
  referenceId   String?

  saleItemId String?   @db.Uuid
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])

  createdById String? @db.Uuid
  createdBy   User?   @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  notes     String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([saleItemId])
  @@map("inventory_movements")
}

/// A received supplier purchase. Its inventory movements are created atomically.
model Purchase {
  id String @id @default(uuid()) @db.Uuid

  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  receivedAt    DateTime @default(now())
  supplierFolio String?
  notes         String?
  total         Decimal  @db.Decimal(12, 2)

  createdById String @db.Uuid
  createdBy   User   @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items     PurchaseItem[]
  createdAt DateTime       @default(now())

  @@index([providerId, receivedAt])
  @@index([receivedAt])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(uuid()) @db.Uuid

  purchaseId String   @db.Uuid
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  position     Int
  productName  String
  barcode      String
  quantity     Decimal @db.Decimal(14, 3)
  unitCost     Decimal @db.Decimal(12, 2)
  lineSubtotal Decimal @db.Decimal(12, 2)

  @@unique([purchaseId, position])
  @@index([productId])
  @@map("purchase_items")
}

model Quote {
  id     String      @id @default(uuid()) @db.Uuid
  folio  String      @unique
  status QuoteStatus @default(DRAFT)

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  items QuoteItem[]

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes     String?
  expiresAt DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  convertedSale Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id String @id @default(uuid()) @db.Uuid

  quoteId String @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  sizeId String? @db.Uuid
  size   Size?   @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([sizeId])
  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model Sale {
  id     String     @id @default(uuid()) @db.Uuid
  folio  String     @unique
  status SaleStatus @default(PENDING)

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  quoteId String? @unique @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  items    SaleItem[]
  payments Payment[]

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  createdById String? @db.Uuid
  createdBy   User?   @relation("SaleCreatedBy", fields: [createdById], references: [id])

  notes String?

  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelledBy   User?     @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  sizeId String? @db.Uuid
  size   Size?   @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  quantity  Decimal  @db.Decimal(14, 3)
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  tax       Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  // Product.cost when sold; null for sales recorded before the snapshot.
  unitCost  Decimal? @db.Decimal(12, 2)

  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())

  @@index([sizeId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  saleId String @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id])

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  provider          String?
  providerReference String? @unique

  createdById String? @db.Uuid
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  idempotencyKeys IdempotencyKey[]

  // Closure that counted the incoming money / the refund outflow.
  cashClosureId   String?      @db.Uuid
  cashClosure     CashClosure? @relation("CashClosurePayments", fields: [cashClosureId], references: [id], onDelete: Restrict)
  refundClosureId String?      @db.Uuid
  refundClosure   CashClosure? @relation("CashClosureRefunds", fields: [refundClosureId], references: [id], onDelete: Restrict)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([saleId])
  @@index([status])
  @@index([cashClosureId])
  @@index([refundClosureId])
  @@map("payments")
}

model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  key         String
  scope       String
  requestHash String
  status      IdempotencyStatus @default(PENDING)

  responseStatusCode Int?
  responseBody       Json?
  errorMessage       String?

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, scope])
  @@index([userId])
  @@index([paymentId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ExpenseCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expense_categories")
}

model Expense {
  id             String  @id @default(uuid()) @db.Uuid
  concept        String
  amount         Decimal @db.Decimal(12, 2)
  deductFromCash Boolean @default(false)
  notes          String?

  spentAt DateTime @default(now())

  categoryId String          @db.Uuid
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  cashClosureId String?      @db.Uuid
  cashClosure   CashClosure? @relation(fields: [cashClosureId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cashClosureId])
  @@index([spentAt])
  @@index([categoryId])
  @@index([createdById])
  @@map("expenses")
}

model CashClosure {
  id String @id @default(uuid()) @db.Uuid

  // Chain of closures; unique so two closures cannot follow the same one.
  previousClosureId String?      @unique @db.Uuid
  previousClosure   CashClosure? @relation("CashClosureChain", fields: [previousClosureId], references: [id], onDelete: Restrict)
  nextClosure       CashClosure? @relation("CashClosureChain")

  periodStart DateTime?
  closedAt    DateTime  @default(now())

  closedById String @db.Uuid
  closedBy   User   @relation("CashClosureClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  openingFloat   Decimal @db.Decimal(12, 2)
  salesCount     Int
  cashSales      Decimal @db.Decimal(12, 2)
  cardSales      Decimal @db.Decimal(12, 2)
  transferSales  Decimal @db.Decimal(12, 2)
  otherSales     Decimal @db.Decimal(12, 2)
  cashRefunds    Decimal @db.Decimal(12, 2)
  totalRefunds   Decimal @db.Decimal(12, 2)
  expensesCount  Int
  cashExpenses   Decimal @db.Decimal(12, 2)
  totalExpenses  Decimal @db.Decimal(12, 2)
  adjustmentsIn  Decimal @db.Decimal(12, 2)
  adjustmentsOut Decimal @db.Decimal(12, 2)
  expectedCash   Decimal @db.Decimal(12, 2)
  countedCash    Decimal @db.Decimal(12, 2)
  difference     Decimal @db.Decimal(12, 2)
  floatLeft      Decimal @db.Decimal(12, 2)
  denominations  Json
  notes          String?

  adjustments CashClosureAdjustment[]
  payments    Payment[]               @relation("CashClosurePayments")
  refunds     Payment[]               @relation("CashClosureRefunds")
  expenses    Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([closedAt])
  @@map("cash_closures")
}

model CashClosureAdjustment {
  id String @id @default(uuid()) @db.Uuid

  cashClosureId String      @db.Uuid
  cashClosure   CashClosure @relation(fields: [cashClosureId], references: [id], onDelete: Cascade)

  // Order in which the cashier entered it.
  position    Int
  type        CashAdjustmentType
  amount      Decimal            @db.Decimal(12, 2)
  description String

  createdAt DateTime @default(now())

  @@unique([cashClosureId, position])
  @@map("cash_closure_adjustments")
}

/// Single-row business identity printed on tickets; always key = "default".
/// Public API keeps the Spanish names (nombre, direccion, ...).
model BusinessConfig {
  key          String @id @default("default")
  name         String
  address      String
  neighborhood String
  municipality String
  state        String
  phone        String
  taxId        String
  ticketFooter String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_config")
}

/// Supplier directory. Public API keeps the Spanish names (nombre, telefono, ...).
model Provider {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  phone       String?
  email       String?
  contactName String?
  address     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("providers")
}
